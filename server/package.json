{
  "name": "polyops-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed": "node --env-file-if-exists=../.env ./node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "demo:reset-owner": "node --env-file-if-exists=../.env ./node_modules/tsx/dist/cli.mjs scripts/admin/resetDemoOwner.ts",
    "admin:create-shop": "tsx scripts/admin/createShop.ts",
    "admin:delete-shop": "tsx scripts/admin/deleteShop.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@sentry/node": "^10.78.0",
    "better-auth": "^1.7.26",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
