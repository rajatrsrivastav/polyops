{
  "name": "packbay-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed": "tsx scripts/seed.ts",
    "admin:create-shop": "tsx scripts/admin/createShop.ts",
    "admin:delete-shop": "tsx scripts/admin/deleteShop.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@sentry/node": "^10.78.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "mongoose": "^9.0.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
